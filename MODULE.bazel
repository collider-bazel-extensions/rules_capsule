"""rules_capsule — hermetic Project Capsule install + readiness for Bazel tests."""

module(
    name = "rules_capsule",
    version = "0.1.3",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.7.0")

capsule = use_extension("//:extensions.bzl", "capsule")

# Download mode: Bazel resolves a pinned cert-manager manifest (smoke-test only)
# and exposes the pre-rendered Capsule manifest (committed under
# private/manifests/) via a toolchain.
capsule.version(
    name = "capsule",
    version = "0.10.4",
)

use_repo(capsule, "capsule")

register_toolchains("@capsule//:all")

# ---- dev-only: smoke test composition ---------------------------------------
# Consumers do NOT inherit any of these. The in-tree smoke test composes a
# kind cluster, cert-manager (via rules_certmanager), and capsule_install via
# rules_itest. Both sibling rule sets are pinned via git_override since they
# are not (yet) in BCR.
bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

bazel_dep(name = "rules_kind", version = "0.1.1", dev_dependency = True)
git_override(
    module_name = "rules_kind",
    remote = "https://github.com/collider-bazel-extensions/rules_kind",
    commit = "3f4ff6166c120f9594f572350648c8a9af8616c8",  # v0.1.1 — rootless-podman TMPDIR fix + CI matrix
)

bazel_dep(name = "rules_certmanager", version = "0.1.2", dev_dependency = True)
git_override(
    module_name = "rules_certmanager",
    remote = "https://github.com/collider-bazel-extensions/rules_certmanager",
    commit = "bff7f86589c7a58a42a989f08cb098d790963f06",  # v0.1.2 — block install on Deployments-Available
)

cert_manager = use_extension("@rules_certmanager//:extensions.bzl", "cert_manager", dev_dependency = True)
cert_manager.version(version = "1.18.3")
use_repo(cert_manager, "cert_manager")
register_toolchains("@cert_manager//:all", dev_dependency = True)

# ---- dev-only: rules_helm + chart fetch for the maintainer render flow ------
# Consumers don't inherit any of this. The chart .tgz is fetched (sha-pinned
# from CAPSULE_VERSIONS) so `bazel run //tools:render_writeback -- <version>`
# can render the manifest hermetically without host helm.
bazel_dep(name = "rules_helm", version = "0.2.1", dev_dependency = True)
git_override(
    module_name = "rules_helm",
    remote = "https://github.com/collider-bazel-extensions/rules_helm",
    commit = "48651387d55f0c50f6d059df246ed73767100afb",  # v0.2.1 — subchart-aware chart-root detection
)

helm = use_extension("@rules_helm//:extensions.bzl", "helm", dev_dependency = True)
helm.version(version = "3.20.2")
use_repo(helm,
    "helm_linux_amd64",
    "helm_darwin_amd64",
    "helm_darwin_arm64",
)
register_toolchains(
    "@helm_linux_amd64//:toolchain",
    "@helm_darwin_amd64//:toolchain",
    "@helm_darwin_arm64//:toolchain",
    dev_dependency = True,
)

capsule_chart = use_extension("//tools:extensions.bzl", "capsule_chart", dev_dependency = True)
capsule_chart.version(version = "0.10.4")
use_repo(capsule_chart, "capsule_chart_0_10_4")
